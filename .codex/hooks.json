{
  "description": "Adaptadores de Codex: lógica y memoria únicas en .claude/. No importar copias.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/codex-context.py\"",
            "timeout": 5,
            "additionalContextLimit": 10000,
            "statusMessage": "Cargando memoria compartida de Levy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/memory-recall.py\"",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/candado-freno.py\" --runtime codex",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/candado-pantalla.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/capture-conversation.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/capture-conversation.py\" --runtime codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
