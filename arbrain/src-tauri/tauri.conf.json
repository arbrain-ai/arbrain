{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arbrain",
  "version": "0.1.3",
  "identifier": "ai.arbrain.app",
  "build": {
    "beforeDevCommand": "node scripts/desktop-dev-server.mjs",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build && node scripts/prepare-tauri-resources.mjs",
    "frontendDist": "../public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Arbrain",
        "create": false,
        "url": "http://localhost:3000",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": [
        {
          "identifier": "cliente-local",
          "description": "Edición cliente: la pantalla de arranque (contenido local de la app) no necesita más que lo básico. El origen del servidor local recibe sus permisos en tiempo de ejecución (lib.rs, conceder_ipc_cliente), atados a su puerto exacto.",
          "local": true,
          "windows": [
            "splash"
          ],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.cliente.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "resources": {
      "resources/next": "next",
      "resources/daemon": "daemon",
      "resources/plantilla-cerebro": "plantilla-cerebro",
      "resources/manos": "manos"
    },
    "externalBin": [
      "binaries/arbrain-node"
    ],
    "linux": {
      "deb": {
        "depends": [
          "bubblewrap",
          "socat",
          "libdbus-1-3"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/desinstalar.nsh"
      }
    }
  }
}
