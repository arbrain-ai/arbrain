# @anthropic-ai/claude-agent-sdk@0.3.x declares a peer on @anthropic-ai/sdk
# (>=0.93.0) that ERESOLVE flags against the nested 0.100.1, even though it is
# satisfied. legacy-peer-deps makes `npm ci` (used by scripts/auto-deploy.sh on
# the Mac Mini) resolve the same way as local — without it the daemon never
# updates. Remove once the upstream peer graph is consistent.
legacy-peer-deps=true
