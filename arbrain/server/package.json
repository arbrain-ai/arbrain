{
  "name": "claudeclaw",
  "version": "1.0.0",
  "description": "Personal AI assistant — Claude Code on Mac Mini via Mission Control",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:cliente": "node scripts/build-cliente.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "herramientas:tamano": "tsx scripts/tamano-herramientas.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@supabase/supabase-js": "^2.103.0",
    "ai": "7.0.107",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^4.9.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.20.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
