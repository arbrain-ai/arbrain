{
  "name": "arbrain",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -H 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/pruebas-web.mjs",
    "servidor": "node scripts/servidor.mjs",
    "escritorio": "node scripts/escritorio.mjs",
    "desktop:dev": "MISSION_CONTROL_DESKTOP_PORT=3000 node scripts/tauri.mjs dev",
