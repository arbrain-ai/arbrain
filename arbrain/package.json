    "desktop:node": "node scripts/fetch-node.mjs",
    "desktop:daemon:cliente": "node scripts/empaquetar-daemon.mjs",
    "desktop:revisar-paquete": "node scripts/paquete-seguro.mjs",
    "desktop:open": "open \"$HOME/Applications/Arbrain.app\"",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:logs": "tail -f /tmp/mission-control-desktop.log",
    "desktop:bundle": "node scripts/tauri.mjs build",
    "desktop:info": "node scripts/tauri.mjs info"
  },
